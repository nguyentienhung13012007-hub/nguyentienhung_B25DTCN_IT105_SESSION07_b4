        <mxCell id="zK5bvfVn2MMnDjZPPoYJ-19" parent="zK5bvfVn2MMnDjZPPoYJ-15" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;" value="# paymentDate : Date&amp;nbsp;" vertex="1">
