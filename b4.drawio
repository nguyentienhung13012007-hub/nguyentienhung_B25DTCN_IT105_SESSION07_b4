        </mxCell>
        <mxCell id="zK5bvfVn2MMnDjZPPoYJ-13" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="&lt;li&gt;&lt;p&gt;&lt;span&gt;Giải pháp 1: Sử dụng Abstract Class (&lt;code style=&quot;&quot;&gt;Payment&lt;/code&gt;)&lt;/span&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;&lt;p&gt;Tạo một Abstract Class tên là &lt;code&gt;Payment&lt;/code&gt; chứa các thuộc tính dùng chung (&lt;code&gt;transactionId&lt;/code&gt;, &lt;code&gt;amount&lt;/code&gt;, &lt;code&gt;paymentDate&lt;/code&gt;) và khai báo phương thức trừu tượng &lt;code&gt;+ processPayment(): boolean&lt;/code&gt;.&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p&gt;Các lớp con cụ thể (&lt;code&gt;CreditCardPayment&lt;/code&gt;, &lt;code&gt;EWalletPayment&lt;/code&gt;, &lt;code&gt;BankTransferPayment&lt;/code&gt;) kế thừa từ &lt;code&gt;Payment&lt;/code&gt; và tự ghi đè (override) logic kết nối API tương ứng trong phương thức &lt;code&gt;processPayment()&lt;/code&gt;.&lt;/p&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/li&gt;&lt;li&gt;&lt;p&gt;&lt;span&gt;Giải pháp 2: Sử dụng Interface (&lt;code&gt;IPayment&lt;/code&gt;) kết hợp lưu trữ thuộc tính độc lập&lt;/span&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;&lt;p&gt;Định nghĩa một Interface &lt;code&gt;IPayment&lt;/code&gt; chỉ chứa phương thức &lt;code&gt;+ processPayment(): boolean&lt;/code&gt;.&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p&gt;Các lớp &lt;code style=&quot;&quot;&gt;CreditCardPayment&lt;/code&gt;, &lt;code style=&quot;&quot;&gt;EWalletPayment&lt;/code&gt;, &lt;code style=&quot;&quot;&gt;BankTransferPayment&lt;/code&gt; sẽ thực thi (implement) Interface &lt;code style=&quot;&quot;&gt;IPayment&lt;/code&gt;. Tuy nhiên, từng lớp phải tự khai báo lại các thuộc tính chung (&lt;code style=&quot;&quot;&gt;transactionId&lt;/code&gt;, &lt;code style=&quot;&quot;&gt;amount&lt;/code&gt;, &lt;code style=&quot;&quot;&gt;paymentDate&lt;/code&gt;).&lt;/p&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/li&gt;" vertex="1">
          <mxGeometry height="150" width="660" x="-180" y="-210" as="geometry" />
        </mxCell>
        <mxCell id="zK5bvfVn2MMnDjZPPoYJ-14" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="&lt;h3 style=&quot;font-family: &amp;quot;Google Sans&amp;quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot;&gt;&lt;b style=&quot;font-family: &amp;quot;Google Sans Text&amp;quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot;&gt;Phần 2: Bảng so sánh Trade-off (Đánh đổi)&lt;/b&gt;&lt;/h3&gt;&lt;table style=&quot;margin-bottom: 32px; font-family: &amp;quot;Google Sans Text&amp;quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot;&gt;&lt;thead style=&quot;line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot;&gt;&lt;tr style=&quot;line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot;&gt;&lt;td style=&quot;border: 1px solid rgb(196, 199, 197); padding: 8px 12px; line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot;&gt;&lt;strong style=&quot;line-height: 1.15 !important; margin: 0px !important;&quot;&gt;Tiêu chí&lt;/strong&gt;&lt;/td&gt;&lt;td style=&quot;border: 1px solid rgb(196, 199, 197); padding: 8px 12px; line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot;&gt;&lt;strong style=&quot;line-height: 1.15 !important; margin: 0px !important;&quot;&gt;Giải pháp 1: Abstract Class (Payment)&lt;/strong&gt;&lt;/td&gt;&lt;td style=&quot;border: 1px solid rgb(196, 199, 197); padding: 8px 12px; line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot;&gt;&lt;strong style=&quot;line-height: 1.15 !important; margin: 0px !important;&quot;&gt;Giải pháp 2: Interface (IPayment)&lt;/strong&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/thead&gt;&lt;tbody style=&quot;line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot;&gt;&lt;tr style=&quot;line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot;&gt;&lt;td style=&quot;border: 1px solid rgb(196, 199, 197); padding: 8px 12px; line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot;&gt;&lt;span style=&quot;line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot;&gt;&lt;b style=&quot;line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot;&gt;Khả năng tái sử dụng mã nguồn (DRY)&lt;/b&gt;&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;border: 1px solid rgb(196, 199, 197); padding: 8px 12px; line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot;&gt;&lt;span style=&quot;line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot;&gt;&lt;b style=&quot;line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot;&gt;Rất tốt:&lt;/b&gt; Tái sử dụng toàn bộ thuộc tính chung ở lớp cha, không bị lặp mã.&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;border: 1px solid rgb(196, 199, 197); padding: 8px 12px; line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot;&gt;&lt;span style=&quot;line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot;&gt;&lt;b style=&quot;line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot;&gt;Kém:&lt;/b&gt; Phải khai báo lặp đi lặp lại các thuộc tính chung ở từng lớp con.&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot;&gt;&lt;td style=&quot;border: 1px solid rgb(196, 199, 197); padding: 8px 12px; line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot;&gt;&lt;span style=&quot;line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot;&gt;&lt;b style=&quot;line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot;&gt;Tuân thủ Nguyên lý Open/Closed (OCP)&lt;/b&gt;&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;border: 1px solid rgb(196, 199, 197); padding: 8px 12px; line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot;&gt;&lt;span style=&quot;line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot;&gt;&lt;b style=&quot;line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot;&gt;Tốt:&lt;/b&gt; Khi thêm phương thức thanh toán mới (như ApplePay), chỉ cần tạo lớp mới kế thừa &lt;code style=&quot;font-family: &amp;quot;Google Sans Text&amp;quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot;&gt;Payment&lt;/code&gt;.&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;border: 1px solid rgb(196, 199, 197); padding: 8px 12px; line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot;&gt;&lt;span style=&quot;line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot;&gt;&lt;b style=&quot;line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot;&gt;Trung bình:&lt;/b&gt; Dễ mở rộng phương thức nhưng gây dư thừa dữ liệu khi lớp mới phải định nghĩa lại toàn bộ thuộc tính.&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot;&gt;&lt;td style=&quot;border: 1px solid rgb(196, 199, 197); padding: 8px 12px; line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot;&gt;&lt;span style=&quot;line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot;&gt;&lt;b style=&quot;line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot;&gt;Tính linh hoạt trong mở rộng&lt;/b&gt;&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;border: 1px solid rgb(196, 199, 197); padding: 8px 12px; line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot;&gt;&lt;span style=&quot;line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot;&gt;Giới hạn bởi đơn kế thừa (Java/C# chỉ cho kế thừa 1 lớp).&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;border: 1px solid rgb(196, 199, 197); padding: 8px 12px; line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot;&gt;&lt;span style=&quot;line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot;&gt;Linh hoạt hơn do một lớp có thể thực thi nhiều Interface.&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot;&gt;&lt;td style=&quot;border: 1px solid rgb(196, 199, 197); padding: 8px 12px; line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot;&gt;&lt;span style=&quot;line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot;&gt;&lt;b style=&quot;line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot;&gt;Kết luận / Đánh giá&lt;/b&gt;&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;border: 1px solid rgb(196, 199, 197); padding: 8px 12px; line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot;&gt;&lt;span style=&quot;line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot;&gt;&lt;b style=&quot;line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot;&gt;Tối ưu nhất cho bài toán này&lt;/b&gt; vì vừa đảm bảo tính đóng gói, tránh trùng lặp code, vừa cho phép đa hình ở phương thức xử lý thanh toán.&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;border: 1px solid rgb(196, 199, 197); padding: 8px 12px; line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot;&gt;&lt;span style=&quot;line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot;&gt;Không phù hợp do vi phạm quy tắc &lt;b style=&quot;line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot;&gt;DRY&lt;/b&gt; (Don&#39;t Repeat Yourself).&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/tbody&gt;&lt;/table&gt;" vertex="1">
          <mxGeometry height="240" width="550" x="-120" y="50" as="geometry" />
